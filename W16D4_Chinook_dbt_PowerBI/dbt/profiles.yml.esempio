# Copia questo file come "profiles.yml" nella cartella ~/.dbt (o indica la cartella con --profiles-dir)
# e cambia il percorso del file chinook.sqlite. Serve: pip install dbt-sqlite
chinook_bi:
  target: dev
  outputs:
    dev:
      type: sqlite
      threads: 1
      database: chinook
      schema: main
      schemas_and_paths:
        main: "C:/percorso/della/cartella/chinook.sqlite"
      schema_directory: "C:/percorso/della/cartella/schemas"
